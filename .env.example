# Copy to /etc/agentcontrol/.env on the Iran (agentcontrol) server.
# Never commit the real file — it contains your foreign VPS IP.

# Enable TLS stream edge proxy (see cursor-edge-proxy on foreign VPS)
CURSOR_BRIDGE_ENABLED=true
CURSOR_BRIDGE_EDGE_IP=203.0.113.10
CURSOR_BRIDGE_PORT=33443
CURSOR_BRIDGE_TLS_HOST=api2.cursor.sh

# Computed automatically when saving from the panel; optional manual override:
# CURSOR_API_ENDPOINT=https://api2.cursor.sh:33443
