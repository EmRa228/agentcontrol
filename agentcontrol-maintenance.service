[Unit]
Description=AgentControl maintenance (backups, retention, alerts)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=@INSTALL_DIR@
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=STATE_DIR=@STATE_DIR@
Environment=CONFIG_FILE=@CONFIG_DIR@/config.yaml
ExecStart=@INSTALL_DIR@/venv/bin/python @INSTALL_DIR@/scripts/maintenance.py
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
