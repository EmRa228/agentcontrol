[Unit]
Description=agentcontrol - Cursor agent worker launcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/agentcontrol
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/agentcontrol/env
ExecStart=/opt/agentcontrol/venv/bin/python /opt/agentcontrol/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
