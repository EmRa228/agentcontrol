[Unit]
Description=agentstart - Cursor agent worker launcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/agentstart
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/agentstart/env
ExecStart=/opt/agentstart/venv/bin/python /opt/agentstart/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
