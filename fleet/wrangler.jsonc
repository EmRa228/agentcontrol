{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentcontrol-fleet",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "f696318baf32403db9dfd0a216d9ef85"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
