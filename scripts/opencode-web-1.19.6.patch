diff --git a/packages/app/src/runtime/platform/base-path-router.tsx b/packages/app/src/runtime/platform/base-path-router.tsx
new file mode 100644
index 0000000..0dfe885
--- /dev/null
+++ b/packages/app/src/runtime/platform/base-path-router.tsx
@@ -0,0 +1,66 @@
+import {
+  type BaseRouterProps,
+  createBeforeLeave,
+  createRouter,
+  keepDepth,
+  notifyIfNotBlocked,
+  saveCurrentDepth,
+} from "@solidjs/router"
+import { basePath, stripBasePath, withBasePath } from "@/runtime/platform/base-path"
+
+/**
+ * A history router for builds served under a base path. Unlike the router's own `base`, it keeps every route path the
+ * app sees base-free, so code reading `useLocation().pathname` or navigating to it works the same under any base.
+ */
+export function BasePathRouter(props: BaseRouterProps) {
+  const read = () => {
+    const state = history.state
+
+    return {
+      value: stripBasePath(location.pathname + location.search + location.hash),
+      // The router marks its own entries with only a depth; that is not app state.
+      state: state && state._depth && Object.keys(state).length === 1 ? undefined : state,
+    }
+  }
+
+  const beforeLeave = createBeforeLeave()
+
+  return createRouter({
+    get: read,
+    set({ value, replace, scroll, state }) {
+      const url = withBasePath(value)
+
+      if (replace) history.replaceState(keepDepth(state), "", url)
+      else history.pushState(state, "", url)
+
+      const hash = decodeURIComponent(location.hash.slice(1))
+      const target = hash && document.getElementById(hash)
+
+      if (target) target.scrollIntoView()
+      else if (scroll) window.scrollTo(0, 0)
+
+      saveCurrentDepth()
+    },
+    init: (notify) => {
+      const handler = notifyIfNotBlocked(notify, (delta) => {
+        if (delta) return !beforeLeave.confirm(delta)
+
+        const source = read()
+
+        return !beforeLeave.confirm(source.value, { state: source.state })
+      })
+
+      window.addEventListener("popstate", handler)
+
+      return () => window.removeEventListener("popstate", handler)
+    },
+    utils: {
+      go: (delta) => history.go(delta),
+      renderPath: withBasePath,
+      parsePath: stripBasePath,
+      beforeLeave,
+    },
+  })(props)
+}
+
+export const baseRouter = basePath ? BasePathRouter : undefined
diff --git a/packages/app/src/runtime/platform/base-path.ts b/packages/app/src/runtime/platform/base-path.ts
new file mode 100644
index 0000000..220a322
--- /dev/null
+++ b/packages/app/src/runtime/platform/base-path.ts
@@ -0,0 +1,28 @@
+/** The path a build is served under, such as `/opencode`, without a trailing slash; empty at the root. */
+export const basePath = normalizeBasePath(import.meta.env.BASE_URL)
+
+export function normalizeBasePath(base: string | undefined) {
+  const trimmed = (base ?? "").replace(/^\/+|\/+$/g, "")
+
+  return trimmed ? `/${trimmed}` : ""
+}
+
+/** The browser path for an app path, such as `/opencode/new-session` for `/new-session`. */
+export function withBasePath(path: string, base = basePath) {
+  if (!base) return path
+
+  return path === "/" ? `${base}/` : `${base}${path}`
+}
+
+/** The app path for a browser path, or the path itself when it lies outside the base. */
+export function stripBasePath(path: string, base = basePath) {
+  if (!base || !path.startsWith(base)) return path
+
+  const rest = path.slice(base.length)
+
+  if (rest.startsWith("/")) return rest
+
+  if (rest === "" || rest.startsWith("?") || rest.startsWith("#")) return `/${rest}`
+
+  return path
+}
