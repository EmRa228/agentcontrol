+function ProjectLaunch() {
+  const [search, setSearch] = useSearchParams<{ directory?: string }>()
+  const location = useLocation()
+  const global = useGlobal()
+  const servers = useServers()
+  const tabs = useTabs()
+  let launched = false
+
+  createEffect(() => {
+    const directory = search.directory
+    if (launched || location.pathname !== "/" || !directory?.startsWith("/") || !tabs.ready()) return
+    const connection = servers.list.find((conn) => servers.current(conn)) ?? servers.list[0]
+    if (!connection) return
+    const server = ServerConnection.key(connection)
+    const ctx = global.serverCtx(server)
+    if (!ctx) return
+    launched = true
+    void ctx.projects.add(directory)
+    setSearch({ directory: undefined }, { replace: true })
+    void tabs.newDraft({ server, directory })
+  })
+
+  return null
+}
